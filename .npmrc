@tindevelopers:registry=https://npm.pkg.github.com
# Auth comes from a user-level ~/.npmrc or CI secret (a PAT with read:packages), never committed here:
#   //npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
# Local dev links the shell packages via link: deps in package.json, so the registry token
# is only required in CI/production (where the link: deps are swapped for published versions).
link-workspace-packages=true
