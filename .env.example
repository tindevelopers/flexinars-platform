# ---------------------------------------------------------------------------
# Global Flexinars CE Platform — Admin app environment (TEMPLATE)
# Copy to .env.local and fill in real values. .env.local is gitignored.
# ---------------------------------------------------------------------------

# Auth provider used by the shell (Neon Better Auth).
NEXT_PUBLIC_AUTH_PROVIDER=neon

# Public base URL used to build learner invite links: {NEXT_PUBLIC_APP_URL}/course/{invite_token}
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres connection string (pooled). Get it from the Neon console.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# ---- Neon Managed Better Auth ----
# Base URL of the Neon Auth instance. Copy from Neon console -> Auth.
NEON_AUTH_BASE_URL=PASTE_FROM_NEON_CONSOLE_HERE
# Same value, exposed to the browser for the auth client SDK.
NEXT_PUBLIC_NEON_AUTH_BASE_URL=PASTE_FROM_NEON_CONSOLE_HERE
# Cookie signing secret for Neon Auth (min 32 chars). Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=GENERATE_WITH_openssl_rand_base64_32

# ---- Brevo (transactional email) ----
# API key from the Brevo dashboard. Until set, invite emails are skipped
# gracefully (the enrollment is still created).
BREVO_API_KEY=PASTE_FROM_BREVO_HERE
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=PASTE_FROM_BREVO_HERE

# ---- Email sender identity used for invite emails ----
# EMAIL_FROM_ADDRESS must be a Brevo-verified sender or sends will be rejected.
EMAIL_PROVIDER=brevo
EMAIL_FROM_ADDRESS=globalflexinars@tin.info
EMAIL_FROM_NAME=Global Flexinars CE
ADMIN_EMAIL=admin@globalflexinars.com

# Participant experience — seconds the video gate counts down before the quiz
# unlocks. Default 300 (5 min) in production; set to a small value (e.g. 10) in dev.
NEXT_PUBLIC_VIDEO_GATE_SECONDS=300
