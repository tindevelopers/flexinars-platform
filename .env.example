# ---------------------------------------------------------------------------
# Global Flexinars CE Platform — Admin app environment (TEMPLATE)
# Copy to .env.local and fill in real values. .env.local is gitignored.
# ---------------------------------------------------------------------------

# Auth provider used by the shell (Neon Better Auth).
NEXT_PUBLIC_AUTH_PROVIDER=neon

# Neon Postgres connection string (pooled). Get it from the Neon console.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# Neon Auth (Better Auth) base URL. Copy from Neon console -> Auth.
NEON_AUTH_BASE_URL=PASTE_FROM_NEON_CONSOLE_HERE

# Cookie signing secret for Neon Auth. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=GENERATE_WITH_openssl_rand_base64_32

# Brevo (transactional email) API key. Copy from the Brevo dashboard.
# Until this is set, invite emails are skipped gracefully (enrollment is still created).
BREVO_API_KEY=PASTE_FROM_BREVO_HERE

# Email provider + sender identity used for invite emails.
EMAIL_PROVIDER=brevo
EMAIL_FROM_ADDRESS=noreply@globalflexinars.com
EMAIL_FROM_NAME=Global Flexinars CE
ADMIN_EMAIL=admin@globalflexinars.com

# Public base URL used to build learner invite links: {NEXT_PUBLIC_APP_URL}/course/{invite_token}
NEXT_PUBLIC_APP_URL=http://localhost:3000
